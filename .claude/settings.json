{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npx tsc *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push -u origin claude/*)",
      "Bash(git push origin claude/*)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(gh issue *)",
      "Bash(vercel ls*)",
      "Bash(vercel inspect *)",
      "Bash(vercel logs *)",
      "Bash(node_modules/.bin/tsc *)",
      "Bash(npx tsc *)"
    ],
    "ask": [
      "Bash(git push origin main*)",
      "Bash(git merge *)",
      "Bash(vercel --prod*)",
      "Bash(vercel deploy --prod*)",
      "Bash(vercel promote *)",
      "Bash(vercel env add *)",
      "Bash(vercel env rm *)",
      "Bash(supabase db push*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./**/.env.local)",
      "Read(./.env.production*)",
      "Bash(cat .env*)",
      "Bash(vercel env pull*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf *)",
      "Bash(supabase db reset*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/controllo-finale.sh",
            "timeout": 180
          }
        ]
      }
    ]
  }
}